---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Form from "../components/Form.astro";
import { site } from "../data/site";
---

<Layout
  title={`Tell us what you want · ${site.name}`}
  description="Looking for a specific car? Tell Serene Quality Motors the make, model and budget — we'll call when one lands on the lot."
>
  <Header />
  <main id="main">
    <section class="bg-charcoal text-alabaster">
      <div class="container-sqm py-20 md:py-28">
        <div class="max-w-3xl">
          <p class="label text-alabaster/80">Vehicle wanted</p>
          <h1 class="display-2 mt-4">Tell us what you want</h1>
          <p class="mt-6 max-w-2xl text-lg text-alabaster/80">
            Don't see it on the lot? Tell us the make, model and budget, and we'll call you when a
            matching vehicle comes in.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-alabaster text-charcoal">
      <div class="container-sqm max-w-3xl py-16 md:py-24">
        <Form
          id="tell-us-form"
          heading="What are you looking for?"
          hiddenFields={{ formName: "tell-us", subject: "New vehicle request" }}
          fields={[
            {
              name: "wanted",
              label: "Make / model wanted",
              required: true,
              full: true,
              placeholder: "e.g. Toyota RAV4, AWD, under 100,000 km",
            },
            {
              name: "budget",
              label: "Budget",
              required: true,
              placeholder: "e.g. up to $20,000",
            },
            { name: "name", label: "Name", required: true, autocomplete: "name" },
            { name: "phone", label: "Phone", type: "tel", required: true, autocomplete: "tel" },
          ]}
          submitLabel="Send my request"
        />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
