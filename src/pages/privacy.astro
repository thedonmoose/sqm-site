---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site, fullAddress, telHref } from "../data/site";

const callHref = telHref();
---

<Layout
  title={`Privacy · ${site.name}`}
  description="How Serene Quality Motors handles the personal information you share through this website."
>
  <Header />
  <main id="main">
    <section class="bg-charcoal text-alabaster">
      <div class="container-sqm py-16 md:py-24">
        <p class="label text-alabaster/80">Legal</p>
        <h1 class="display-2 mt-4">Privacy</h1>
      </div>
    </section>

    <section class="bg-alabaster text-charcoal">
      <div class="container-sqm py-16 md:py-24">
        <div
          role="note"
          class="border border-charcoal/40 bg-charcoal px-5 py-4 text-alabaster"
        >
          <p class="label">Provisional draft — to be reviewed before launch</p>
        </div>

        <div class="mt-12 max-w-3xl space-y-10">
          <p>
            This page explains, in plain language, what happens to the information you share with{" "}
            {site.name} through this website. It applies to {site.name}, {fullAddress()}.
          </p>

          <section>
            <h2 class="text-2xl font-semibold">What we collect</h2>
            <p class="mt-3">
              What you type into our forms: your name, phone number, email address, and the details
              of your message or request (for example the vehicle you're asking about, a preferred
              test-drive time, or your budget).
            </p>
            <p class="mt-3">
              Like any website, the services that deliver our pages also receive technical
              information from your browser, such as your IP address, browser type and the page you
              visited. We don't use analytics, advertising trackers or cookies of our own.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-semibold">How we use it</h2>
            <p class="mt-3">
              To answer your question, arrange your test drive, or call you when a vehicle you asked
              about arrives. That's it. We don't add you to marketing lists, and we never sell or
              rent your information to anyone.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-semibold">Who else sees it</h2>
            <p class="mt-3">
              We never sell or rent your information. These services handle it so the site can work:
            </p>
            <ul class="mt-3 list-disc space-y-2 pl-5">
              <li>
                <strong>Web3Forms</strong> receives what you submit through our forms and emails it
                to us. Web3Forms operates from India and stores submissions on Amazon Web Services
                for up to three years, so your information may be processed and stored outside
                Canada, where foreign laws apply. See the{" "}
                <a href="https://web3forms.com/privacy" class="underline underline-offset-4">Web3Forms privacy policy</a>.
              </li>
              <li>
                <strong>Google</strong> serves the map on our home and contact pages, which loads
                automatically as you scroll to it, and the Google reviews and reviewer profile
                photos on our home page. Google receives your IP address and the page you're on
                under the{" "}
                <a href="https://policies.google.com/privacy" class="underline underline-offset-4">Google privacy policy</a>.
              </li>
              <li>
                <strong>Cloudflare</strong> hosts this website and <strong>Sanity</strong> serves
                our vehicle photos. Both receive the technical information described above, and both
                may process it outside Canada.
              </li>
              <li>
                If you tap our WhatsApp link, your conversation is handled by WhatsApp under its own
                privacy policy.
              </li>
            </ul>
            <p class="mt-3">
              Otherwise, your information stays with us except where the law requires disclosure.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-semibold">How long we keep it</h2>
            <p class="mt-3">
              Only as long as we need it to handle your enquiry, and any longer period required by
              Ontario's record-keeping rules for motor vehicle dealers. After that we delete it from
              our records. Copies held by Web3Forms are deleted automatically after three years.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-semibold">Your choices</h2>
            <p class="mt-3">
              You can ask what information we hold about you, ask us to correct it, or ask us to
              delete it. Just contact us and we'll take care of it.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-semibold">Contact us about privacy</h2>
            <p class="mt-3">
              {
                callHref && site.phone ? (
                  <a href={callHref} class="underline underline-offset-4">{site.phone}</a>
                ) : (
                  <span class="italic opacity-70">[Phone — TBC]</span>
                )
              }
              {" · "}
              {
                site.email ? (
                  <a href={`mailto:${site.email}`} class="underline underline-offset-4">{site.email}</a>
                ) : (
                  <span class="italic opacity-70">[Email — TBC]</span>
                )
              }
              {" · "}
              {fullAddress()}
            </p>
          </section>

          <p class="border-t border-charcoal/25 pt-6 text-sm opacity-70">
            This page describes our current practices and will be updated if they change. It's
            provided for information and isn't legal advice.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
