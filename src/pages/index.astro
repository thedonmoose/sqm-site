---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
---

<Layout
  title={`${site.name} — Used cars in Scarborough, ON`}
  description="OMVIC-registered used-car dealer on 4650 Kingston Rd, Scarborough. Every vehicle listed at an honest all-in price with disclosures up front."
>
  <Header />
  <main id="main">
    <section class="bg-charcoal text-alabaster">
      <div class="container-sqm flex flex-col gap-8 py-28 md:py-40">
        <p class="label">{site.name} · Ontario</p>
        <h1 class="display-1 max-w-[1100px]">Foundation build — pages coming next</h1>
        <p class="max-w-2xl text-lg">
          Placeholder page for the SQM site foundation. Home, inventory and vehicle pages land in
          the next build turns.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
