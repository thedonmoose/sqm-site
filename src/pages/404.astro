---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
---

<Layout
  title={`Page not found · ${site.name}`}
  description="That page doesn't exist. See what's on the lot instead."
>
  <div class="flex min-h-dvh flex-col bg-charcoal text-alabaster">
    <Header />
    <main id="main" class="flex flex-1 items-center">
      <div class="container-sqm py-20 text-center md:py-28">
        <h1 class="display-1">404</h1>
        <p class="mx-auto mt-6 max-w-xl text-lg text-alabaster/80">
          That page has left the lot. The rest of the inventory is still here.
        </p>
        <a href="/inventory/" class="btn btn-primary btn-lg mt-10">View inventory</a>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
