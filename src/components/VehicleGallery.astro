---
/** Vehicle photo gallery: fixed 4:3 main frame, single thumbnail strip with
 * +N overflow. Keyboard and touch handled in src/scripts/gallery.ts.
 * Photo category data is kept in the CMS but the gallery shows all photos. */
import type { Vehicle } from "../lib/types";
import { responsiveImage } from "../lib/images";

interface Props {
  vehicle: Vehicle;
}

const { vehicle } = Astro.props;
const MAX_THUMBS = 5;
const mainImage = responsiveImage(vehicle.photos[0].src, "gallery");
---

<div data-gallery class="flex flex-col gap-4">
  <figure class="group relative aspect-4/3 overflow-hidden bg-charcoal/10">
    <img
      data-gallery-main
      src={mainImage.src}
      srcset={mainImage.srcset}
      sizes={mainImage.sizes}
      alt={vehicle.photos[0].alt}
      width="1600"
      height="1200"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover"
    />
    <span
      data-gallery-counter
      class="absolute right-4 bottom-4 bg-charcoal px-3 py-1.5 text-[13px] uppercase tracking-[0.12em] text-alabaster"
    >
      {vehicle.photos.length} photos
    </span>
    <button
      type="button"
      data-gallery-prev
      aria-label="Previous photo"
      class="pointer-coarse:opacity-100 absolute top-1/2 left-4 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-charcoal/80 text-alabaster opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-focus-within:opacity-100 focus-visible:opacity-100 focus-visible:outline-[3px] focus-visible:-outline-offset-3 focus-visible:outline-green"
    >
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
    </button>
    <button
      type="button"
      data-gallery-next
      aria-label="Next photo"
      class="pointer-coarse:opacity-100 absolute top-1/2 right-4 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-charcoal/80 text-alabaster opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-focus-within:opacity-100 focus-visible:opacity-100 focus-visible:outline-[3px] focus-visible:-outline-offset-3 focus-visible:outline-green"
    >
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
    </button>
  </figure>
  <p data-gallery-live class="sr-only" role="status" aria-live="polite"></p>

  <div data-gallery-thumbs class="grid grid-cols-4 gap-2 md:grid-cols-5 md:gap-3">
    {vehicle.photos.map((photo, i) => {
      const image = responsiveImage(photo.src, "thumbnail");
      return (
        <button
          type="button"
          data-gallery-thumb
          data-full={image.src}
          data-full-srcset={image.srcset}
          data-alt={photo.alt}
          aria-label={`Show photo ${i + 1}: ${photo.alt}`}
          aria-pressed={i === 0 ? "true" : "false"}
          class="relative aspect-4/3 overflow-hidden bg-charcoal/10"
        >
          <img
            src={image.src}
            srcset={image.srcset}
            sizes={image.sizes}
            alt=""
            width="1600"
            height="1200"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
          {vehicle.photos.length > MAX_THUMBS && i === MAX_THUMBS - 1 && (
            <span
              data-thumb-more
              class="absolute inset-0 flex items-center justify-center bg-charcoal/60 text-lg font-semibold text-alabaster"
            ></span>
          )}
        </button>
      );
    })}
  </div>
</div>
