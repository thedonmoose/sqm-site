---
import type { Vehicle } from "../lib/types";
import { badgeFor } from "../lib/types";
import {
  formatPrice,
  formatKm,
  formatTransmission,
  vehicleTitle,
  vehicleHref,
} from "../lib/format";

interface Props {
  vehicle: Vehicle;
  /** Injectable so listing pages can share one "today" across badges. */
  today?: Date;
  /** Override for the sold-card "See similar vehicles" target. */
  soldHref?: string;
}

const { vehicle, today = new Date(), soldHref } = Astro.props;
const badge = badgeFor(vehicle, today);
const cover = vehicle.photos[0];
const sold = vehicle.status === "sold";
const soldTarget = soldHref ?? `/inventory/?make=${encodeURIComponent(vehicle.make)}`;
---

<article class="group relative flex h-full flex-col border border-charcoal/30 bg-alabaster text-charcoal">
  <div class="relative aspect-4/3 overflow-hidden bg-charcoal/10">
    <img
      src={cover.src}
      alt={cover.alt}
      width="1200"
      height="900"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover"
    />
    {
      sold ? (
        <span class="absolute top-4 left-4 bg-green px-3 py-1.5 text-[13px] font-bold uppercase tracking-[0.12em] text-alabaster">
          Sold
        </span>
      ) : badge ? (
        <span class="absolute top-4 left-4 bg-charcoal px-3 py-1.5 text-[13px] uppercase tracking-[0.12em] text-alabaster">
          {badge}
        </span>
      ) : null
    }
  </div>

  <div class="flex flex-1 flex-col gap-1.5 p-6">
    <h3 class="min-h-[65px] text-[26px] leading-tight font-semibold">
      <a
        href={vehicleHref(vehicle)}
        class="after:absolute after:inset-0 after:content-[''] group-hover:underline underline-offset-4"
      >
        {vehicleTitle(vehicle)}
      </a>
    </h3>
    <p class="text-[17px] opacity-75">
      {formatKm(vehicle.mileageKm)} · {formatTransmission(vehicle.transmission)} ·
      {vehicle.drivetrain.toUpperCase()}
    </p>

    <div class="mt-4 mb-1 border-t border-charcoal/30"></div>

    {
      sold ? (
        <p class="mb-4 text-lg font-medium">This vehicle has been sold.</p>
      ) : (
        <p class="flex flex-wrap items-baseline gap-3">
          <span class="text-[30px] font-bold">{formatPrice(vehicle.allInPrice)}</span>
          {vehicle.previousPrice != null && vehicle.previousPriceAdvertised === true && (
            <span class="text-[18px] line-through opacity-75">{formatPrice(vehicle.previousPrice)}</span>
          )}
        </p>
      )
    }

    {
      !sold && <p class="mb-4 text-sm opacity-75">All-in price. Plus HST and licensing.</p>
    }

    {
      sold ? (
        <a href={soldTarget} class="btn btn-outline-dark relative z-10 mt-auto w-full">
          See similar vehicles
        </a>
      ) : (
        <span aria-hidden="true" class="btn btn-outline-dark mt-auto w-full">View details</span>
      )
    }
  </div>
</article>
