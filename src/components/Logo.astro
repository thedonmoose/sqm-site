---
/**
 * The one brand logo (alabaster mark for charcoal/hero surfaces), used unaltered.
 * Inlined rather than <img> so it paints with the HTML on every navigation —
 * no network fetch or async decode to flash blank between pages.
 */
import logo from "../assets/sqm-logo.svg?raw";

interface Props {
  class?: string;
}

const { class: className = "h-11 w-auto" } = Astro.props;
const svg = logo.replace("<svg ", `<svg class="${className}" role="img" aria-label="Serene Quality Motors" `);
---

<Fragment set:html={svg} />
