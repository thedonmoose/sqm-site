---
/**
 * Brand logo, used unaltered (public/logos/). "dark-bg" carries alabaster
 * artwork for charcoal/hero surfaces; "light-bg" carries green artwork for
 * light surfaces; "icon-dark" is the icon-only knockout for dark surfaces.
 * Intrinsic sizes keep layout stable at any CSS size.
 */
interface Props {
  variant?: "dark-bg" | "light-bg" | "icon-dark";
  class?: string;
}

const { variant = "dark-bg", class: className = "h-14 w-auto" } = Astro.props;
const art =
  variant === "light-bg"
    ? { src: "/logos/sqm-on-light.svg", width: 1318, height: 922 }
    : variant === "icon-dark"
      ? { src: "/logos/sqm-icon-on-dark.svg", width: 1318, height: 689 }
      : { src: "/logos/sqm-on-dark.svg", width: 1318, height: 922 };
---

<img
  src={art.src}
  width={art.width}
  height={art.height}
  alt="Serene Quality Motors"
  class={className}
  loading="eager"
  decoding="async"
/>
