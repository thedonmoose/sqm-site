---
import Logo from "./Logo.astro";
import { site, telHref } from "../data/site";

interface Props {
  /** Transparent over the hero (home); solid charcoal on interior pages. */
  overlay?: boolean;
  /** Path of the current page for the active nav underline. */
  active?: string;
}

const { overlay = false, active } = Astro.props;
const callHref = telHref();
const navLinks = [
  { href: "/inventory/", label: "Inventory" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
---

<header
  data-sqm-header
  class={overlay ? "absolute inset-x-0 top-0 z-30" : "relative z-30 bg-charcoal text-alabaster"}
>
  <div class="container-sqm flex flex-wrap items-center justify-between gap-x-6 gap-y-4 py-6">
    <a href="/" aria-label="Serene Quality Motors — home" class="shrink-0">
      <Logo variant="dark-bg" class="h-12 w-auto md:h-14" />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-9 text-sm uppercase tracking-[0.18em] md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={active === link.href ? "page" : undefined}
          class:list={[
            "hover:underline underline-offset-4",
            active === link.href && "underline decoration-green decoration-[3px] underline-offset-8",
          ]}
        >
          {link.label}
        </a>
      ))}
      {
        callHref ? (
          <a href={callHref} class="btn btn-primary btn-md">Call {site.phone}</a>
        ) : (
          <span class="btn btn-primary btn-md" aria-disabled="true">Call — number coming soon</span>
        )
      }
    </nav>

    <div class="flex items-center gap-3 md:hidden">
      {
        callHref ? (
          <a href={callHref} class="btn btn-primary btn-md">Call</a>
        ) : (
          <span class="btn btn-primary btn-md" aria-disabled="true">Call — number coming soon</span>
        )
      }
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="sqm-mobile-menu"
        class="inline-flex h-12 w-12 items-center justify-center border border-alabaster/60"
      >
        <span class="sr-only">Open menu</span>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="sqm-mobile-menu"
    data-mobile-menu
    hidden
    aria-label="Mobile"
    class="fixed inset-0 z-40 flex flex-col bg-charcoal text-alabaster"
  >
    <div class="container-sqm flex items-center justify-between py-6">
      <Logo variant="dark-bg" class="h-12 w-auto" />
      <button
        type="button"
        data-menu-close
        class="inline-flex h-12 w-12 items-center justify-center border border-alabaster/60"
      >
        <span class="sr-only">Close menu</span>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19"></path>
        </svg>
      </button>
    </div>
    <div class="container-sqm flex flex-1 flex-col justify-start gap-10 pb-16">
      {navLinks.map((link) => (
        <a href={link.href} class="display-2 hover:underline underline-offset-8">{link.label}</a>
      ))}
      <div class="mt-auto flex flex-col gap-4">
        {
          callHref ? (
            <a href={callHref} class="btn btn-primary btn-lg w-full">Call {site.phone}</a>
          ) : (
            <span class="btn btn-primary btn-lg w-full" aria-disabled="true">Call — number coming soon</span>
          )
        }
      </div>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-sqm-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");

  function isOpen(): boolean {
    return menu !== null && !menu.hidden;
  }

  function setOpen(open: boolean): void {
    if (!menu) return;
    menu.hidden = !open;
    toggle?.setAttribute("aria-expanded", String(open));
    document.documentElement.classList.toggle("overflow-hidden", open);
    if (open) {
      menu.querySelector<HTMLElement>("a, button")?.focus();
    } else {
      toggle?.focus();
    }
  }

  toggle?.addEventListener("click", () => setOpen(isOpen() === false));
  document.querySelector("[data-menu-close]")?.addEventListener("click", () => setOpen(false));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen()) setOpen(false);
  });
  document.addEventListener("click", (event) => {
    if (!isOpen() || !header || !(event.target instanceof Node)) return;
    if (!header.contains(event.target)) setOpen(false);
  });
</script>
