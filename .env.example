# Public site URL used for canonical/OG URLs (falls back to https://sqm-site.pages.dev)
PUBLIC_SITE_URL=

# Web3Forms access key (https://web3forms.com). Forms show an inline error when unset.
PUBLIC_WEB3FORMS_KEY=

# Sanity (optional) — when set at build time, inventory is fetched from the Sanity CDN
# instead of the sample fixture.
SANITY_PROJECT_ID=
SANITY_DATASET=production
